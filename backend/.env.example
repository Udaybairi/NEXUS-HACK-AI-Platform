# Backend environment variables
# Copy this file to .env and fill in values

# JWT secret — change this to a long random string in production
SECRET_KEY=super_secret_hackathon_jwt_key_2026_change_in_production

# ElevenLabs (text-to-speech voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# URL of the deployed AI service (no trailing slash)
AI_SERVICE_URL=http://localhost:8001

# URL of the deployed frontend (for CORS)
FRONTEND_URL=http://localhost:3000
